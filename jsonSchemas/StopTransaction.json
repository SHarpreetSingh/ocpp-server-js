{
    "type": "object",
    "properties": {
        "idTag": {
            "type": "string",
            "maxLength": 20
        },
        "meterStop": {
            "type": "integer",
            "minimum": 1
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "transactionId": {
        "type": "integer",
        "minimum": 1, 
        "description": "The ID of the transaction which is to be stopped/sampled. Must be greater than 0."
},
        "reason": {
            "type": "string",
            "additionalProperties": false,
            "enum": [
                "EmergencyStop",
                "EVDisconnected",
                "HardReset",
                "Local",
                "Other",
                "PowerLoss",
                "Reboot",
                "Remote",
                "SoftReset",
                "UnlockCommand",
                "DeAuthorized"
            ]
        }  
    },
    "additionalProperties": false,
    "required": [
        "transactionId",
        "timestamp",
        "meterStop"
    ]
}
